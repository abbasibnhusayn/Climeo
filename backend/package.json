{
  "name": "climeo-backend",
  "version": "0.1.0",
  "description": "Climeo weather intelligence API — developed by Halool",
  "author": "Halool",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "migrate": "tsx src/db/migrate.ts",
    "check-alerts": "tsx src/notifications/severeWeatherAlert.job.ts",
    "import-cities": "tsx scripts/geonamesImport.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "fastify": "^4.28.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "ioredis": "^5.4.1",
    "pino-pretty": "^11.2.2",
    "zod": "^3.23.8",
    "pg": "^8.12.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "firebase-admin": "^12.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.11",
    "@types/pg": "^8.11.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "adm-zip": "^0.5.16",
    "@types/adm-zip": "^0.5.5",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.4"
  },
  "engines": {
    "node": ">=20"
  }
}
